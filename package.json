{
  "name": "brawlcam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs --external:pg-native --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "server": "node dist-server/server.mjs",
    "server:dev": "tsx watch server/index.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p .",
    "prebuild": "bash scripts/fetch-assets.sh",
    "predev": "bash scripts/fetch-assets.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@pixiv/three-vrm": "^3.5.5",
    "pg": "^8.23.1",
    "three": "^0.186.1",
    "undici": "^8.12.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
